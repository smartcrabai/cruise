{
  extends: [
    'config:best-practices',
  ],
  dependencyDashboard: {
    enabled: false,
  },
  'github-actions': {
    managerFilePatterns: [
      '/(^|/)environments/shared/cruise/workflow\\.yml$/',
    ],
  },
  minimumReleaseAge: '3 days',
  lockFileMaintenance: {
    minimumReleaseAge: null,
  },
  vulnerabilityAlerts: {
    minimumReleaseAge: null,
  },
  packageRules: [
    {
      matchUpdateTypes: [
        'minor',
        'patch',
        'digest',
        'pinDigest',
      ],
      groupName: 'all minor, patch, and digest updates',
      groupSlug: 'all-minor-patch-digest-updates',
    },
    {
      matchUpdateTypes: [
        'major',
      ],
      prBodyNotes: [
        '<!-- renovate-major-update -->',
      ],
    },
    {
      matchManagers: [
        'github-actions',
      ],
      minimumReleaseAge: '7 days',
    },
    {
      matchFileNames: [
        '.github/workflows/cruise.yml',
        'cruise.yaml',
      ],
      enabled: false,
    },
    {
      matchDepNames: [
        'seher-claude-agent-sdk',
      ],
      enabled: false,
    },
    {
      matchUpdateTypes: [
        'digest',
        'pinDigest',
      ],
      minimumReleaseAge: null,
    },
  ],
}
