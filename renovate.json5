{
  extends: [
    "config:best-practices"
  ],
  dependencyDashboard: false,
  // Scan the central source file for Renovate only in the terraforms repository
  // (additive, so the default patterns are still kept; this path does not
  // exist in the distribution target repositories).
  "github-actions": {
    managerFilePatterns: [
      "/(^|/)environments/shared/cruise/workflow\\.yml$/"
    ],
  },
  minimumReleaseAge: "3 days",
  lockFileMaintenance: {
    minimumReleaseAge: null,
  },
  vulnerabilityAlerts: {
    minimumReleaseAge: null,
  },
  packageRules: [
    {
      matchUpdateTypes: [
        "minor",
        "patch",
        "digest",
        "pinDigest"
      ],
      groupName: "all minor, patch, and digest updates",
      groupSlug: "all-minor-patch-digest-updates",
    },
    {
      matchUpdateTypes: [
        "major"
      ],
      prBodyNotes: [
        "<!-- renovate-major-update -->"
      ],
    },
    {
      matchManagers: [
        "github-actions"
      ],
      minimumReleaseAge: "7 days"
    },
    {
      // Do not let files distributed by Terraform be updated on the repository side
      // (to avoid fighting over the source of truth). ignorePaths is non-mergeable
      // and would override the preset's exclusions, so disable via packageRules instead.
      matchFileNames: [
        ".github/workflows/cruise.yml",
        "cruise.yaml",
      ],
      enabled: false,
    },
    {
      // vendor/claude-agent-sdk holds the published .crate of exactly this
      // version and is referenced through [patch.crates-io], so the pin can
      // only move together with a full re-extraction of the vendored copy
      // (scripts/verify_vendored_crate.sh fails on any mismatch). An automerged
      // version-only bump would silently leave the patch unused.
      matchDepNames: [
        "seher-claude-agent-sdk",
      ],
      enabled: false,
    },
    {
      // digest / pinDigest updates carry no releaseTimestamp. Applying
      // minimumReleaseAge to them makes minimumReleaseAgeBehaviour default to
      // "timestamp-required", which unconditionally sets stabilityStatus=yellow,
      // so renovate/stability-days stays pending forever and the PR can never
      // become mergeable - waiting does not help. A digest only tracks the same
      // tag, so "N days since release" does not apply. Must stay last so it
      // overrides the github-actions rule above (string options are non-mergeable
      // and the last matching packageRule wins).
      matchUpdateTypes: [
        "digest",
        "pinDigest"
      ],
      minimumReleaseAge: null,
    }
  ]
}
